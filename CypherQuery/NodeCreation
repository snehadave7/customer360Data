LOAD CSV WITH HEADERS
FROM 'https://raw.githubusercontent.com/snehadave7/customer360Data/main/customer.csv'
AS row

CREATE (:Customer{
    customerId: row.Customer_ID,
    name: row.Name,
    dob: row.DOB,
    pan: row.PAN,
    cif: row.CIF
});

LOAD CSV WITH HEADERS
FROM 'https://raw.githubusercontent.com/snehadave7/customer360Data/main/account.csv'
AS row

CREATE (:Account{
    accountId: row.Account_ID,
    accountType: row.Account_Type,
    status: row.Status
});

LOAD CSV WITH HEADERS
FROM 'https://raw.githubusercontent.com/snehadave7/customer360Data/main/card.csv'
AS row

CREATE (:Card{
    cardId: row.Card_ID,
    cardType: row.Card_Type
});

LOAD CSV WITH HEADERS
FROM 'https://raw.githubusercontent.com/snehadave7/customer360Data/main/address.csv'
AS row

CREATE (:Address{
    addressId: row.Address_ID,
